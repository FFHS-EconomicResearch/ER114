  "Q1 (causal effect)", "E2+",  "Lab 3 DiD / Event Study",                          "Quasi-experimental fallback if A/B test infeasible",
  "Q1 (causal effect)", "E1+ML","Lab 3 Double ML",                                  "High-dimensional controls + unbiased estimate",
  "Q2 (prediction)",    "P",    "Lab 2 cv-Lasso with demographics",                  "Inventory tool ready, OOS RMSE quantified"
) %>%
