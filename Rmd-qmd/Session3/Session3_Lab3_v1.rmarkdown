```{r setup}
#| include: false
library(tidyverse)
library(broom)
library(glue)
library(moderndive)
library(gt)
library(xfun)
library(ggdag)         # DAG construction and analysis
library(dagitty)       # backdoor paths and identification
library(plm)           # panel data and DiD
library(AER)           # IV regression (ivreg)
library(fixest)        # high-dimensional fixed effects, modern DiD

# shared visual identity
theme_set(theme_minimal(base_size = 11))

# colour palette
col_primary   <- "#D50006"
col_secondary <- "#502479"
col_neutral   <- "#686868"
col_accent    <- "#7d0a52"

# load data — date stamp must match the files in data/raw/
date_stamp <- "20260517"  # adjust to the most recent DataImport.R run
tbl_stores  <- read_rds(xfun::from_root("data", "raw",
                       glue::glue("dominicks_stores_{date_stamp}.rds")))
tbl_demo    <- read_rds(xfun::from_root("data", "raw",
                       glue::glue("dominicks_demo_{date_stamp}.rds")))
# Merge data sets
tbl_full   <- tbl_stores %>% left_join(tbl_demo, by = "store")
```

## Scenario — A Third Memo from Sarah Chen

:::{.callout-tip icon=false}
